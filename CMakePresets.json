{
  "version": 3,
  "configurePresets": [
    {
      "name": "xcode",
      "displayName": "Universal macOS plug-in (Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "xcode", "configuration": "Release" },
    { "name": "debug", "configurePreset": "xcode", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "xcode", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
