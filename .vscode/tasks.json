{
  "version": "2.0.0",
  "tasks": [
    { "label": "Echo Trails: Configure Xcode", "type": "process", "command": "cmake", "args": ["--preset", "xcode"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": [] },
    { "label": "Echo Trails: Build Release", "type": "process", "command": "cmake", "args": ["--build", "--preset", "release"], "dependsOn": "Echo Trails: Configure Xcode", "options": { "cwd": "${workspaceFolder}" }, "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$gcc" },
    { "label": "Echo Trails: Test", "type": "process", "command": "ctest", "args": ["--preset", "release"], "dependsOn": "Echo Trails: Build Release", "options": { "cwd": "${workspaceFolder}" }, "group": "test", "problemMatcher": [] }
  ]
}
